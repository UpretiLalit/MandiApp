FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy shared projects
COPY ["Backend/Shared/Shared.Domain/Shared.Domain.csproj", "Shared/Shared.Domain/"]
COPY ["Backend/Shared/Shared.Infrastructure/Shared.Infrastructure.csproj", "Shared/Shared.Infrastructure/"]

# Copy Identity API project
COPY ["Backend/Services/Identity.API/Identity.API.csproj", "Services/Identity.API/"]

# Restore
RUN dotnet restore "Services/Identity.API/Identity.API.csproj"

# Copy source files
COPY Backend/Shared/ Shared/
COPY Backend/Services/Identity.API/ Services/Identity.API/

# Build and publish
WORKDIR "/src/Services/Identity.API"
RUN dotnet publish -c Release -o /app/publish

# Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:${PORT:-8080}

ENTRYPOINT ["dotnet", "Identity.API.dll"]
