FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy shared projects
COPY ["Backend/Shared/Shared.Domain/Shared.Domain.csproj", "Shared/Shared.Domain/"]
COPY ["Backend/Shared/Shared.Infrastructure/Shared.Infrastructure.csproj", "Shared/Shared.Infrastructure/"]

# Copy Logistics Hub project
COPY ["Backend/Services/Logistics.Hub/Logistics.Hub.csproj", "Services/Logistics.Hub/"]

# Restore
RUN dotnet restore "Services/Logistics.Hub/Logistics.Hub.csproj"

# Copy source files
COPY Backend/Shared/ Shared/
COPY Backend/Services/Logistics.Hub/ Services/Logistics.Hub/

# Build and publish
WORKDIR "/src/Services/Logistics.Hub"
RUN dotnet publish -c Release -o /app/publish

# Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:${PORT:-8080}

ENTRYPOINT ["dotnet", "Logistics.Hub.dll"]
