  extractCategories() {
    const cats = new Set(this.products.map(p => p.category));
    this.categories = ['All', ...Array.from(cats)];
  }

  filterByCategory(category: string) {
    this.selectedCategory = category;
    this.applyFilters();
  }

  changeSortOrder(event: any) {
    this.sortBy = event.detail.value;
    this.applyFilters();
  }

  onSearchChange(event: any) {
    this.searchTerm = event.detail.value || '';
    this.applyFilters();
  }

  applyFilters() {
    let filtered = this.products;

    if (this.selectedCategory !== 'All') {
      filtered = filtered.filter(p => p.category === this.selectedCategory);
    }

    if (this.searchTerm) {
      filtered = filtered.filter(p =>
        p.name.toLowerCase().includes(this.searchTerm.toLowerCase())
      );
    }

    // Apply sorting
    filtered = this.sortProducts(filtered);

    this.filteredProducts = filtered;
  }

  sortProducts(products: Product[]): Product[] {
    switch (this.sortBy) {
      case 'price-low':
        return [...products].sort((a, b) => a.currentPrice - b.currentPrice);
      case 'price-high':
        return [...products].sort((a, b) => b.currentPrice - a.currentPrice);
      case 'rating':
        return [...products].sort((a, b) => (b.vendorRating || 0) - (a.vendorRating || 0));
      default:
        return [...products].sort((a, b) => a.name.localeCompare(b.name));
    }
  }

  async quickAdd(product: Product) {
    const loading = await this.loadingController.create({
      message: 'Adding to cart...',
      duration: 500
    });
    await loading.present();

    const cartItem = {
      productId: product.id,
      productName: product.name,
      vendorId: product.vendorId,
      quantity: 1,
      unitPrice: product.currentPrice
    };

    this.orderService.addToCart(cartItem).subscribe({
      next: () => {
        loading.dismiss();
        this.cartCount++;
        this.showToast(`${product.name} added to cart`, 'success');
      },
      error: (error) => {
        loading.dismiss();
        console.error('Error adding to cart:', error);
        this.showToast('Failed to add to cart', 'danger');
      }
    });
  }

  loadCartCount() {
    this.orderService.getCart().subscribe({
      next: (cart) => {
        this.cartCount = cart.cartItems?.length || 0;
      },
      error: (error) => console.error('Error loading cart:', error)
    });
  }

  goToCart() {
    this.router.navigate(['/cart']);
  }

  async showToast(message: string, color: string = 'success') {
    const toast = await this.toastController.create({
      message,
      duration: 2000,
      color,
      position: 'bottom'
    this.filteredProducts = filtered
